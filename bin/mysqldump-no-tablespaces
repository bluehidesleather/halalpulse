#!/bin/sh
set -eu

MYSQLDUMP_BIN="${HALALPULSE_MYSQLDUMP_BIN:-/usr/bin/mysqldump}"

if [ ! -x "$MYSQLDUMP_BIN" ]; then
    echo "mysqldump is unavailable at the configured system path." >&2
    exit 127
fi

USE_SOCKET=0
for ARG in "$@"; do
    if [ "$ARG" = "--host=localhost" ]; then
        USE_SOCKET=1
        break
    fi
done

if [ "$USE_SOCKET" -eq 1 ]; then
    exec "$MYSQLDUMP_BIN" --no-tablespaces --protocol=SOCKET "$@"
fi

exec "$MYSQLDUMP_BIN" --no-tablespaces "$@"
